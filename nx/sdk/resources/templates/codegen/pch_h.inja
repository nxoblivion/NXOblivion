// it, and keeps __imp__##name as the always-original entry point. This is a thin
// thunk, not a same-address alias: &name != &__imp__##name by design.
#define DEFINE_REX_FUNC(name)                                                       \
  extern "C" void __imp__##name(PPCContext& __restrict, uint8_t*);                  \
  __attribute__((weak, noinline)) extern "C" void name(                             \
