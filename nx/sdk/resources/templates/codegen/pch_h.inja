//=============================================================================
// Guest compare-and-swap (stwcx. / stdcx.)
//
// oblivion (2026-11-10), after katamari-nx's tools/guest_cas.py: __atomic_compare_exchange_n with sequentially
// consistent ordering, not the legacy __sync_bool_compare_and_swap. On AArch64 without LSE (the Switch's Cortex-A57)
// GCC follows the legacy builtin's exclusive-load / exclusive-store loop with a `dmb ish` (GCC PR 65697), tens of
// cycles after every reference-count change the game makes; this is the same loop (ldaxr / stlxr) without it. PowerPC's
// lwarx / stwcx. order nothing, and the guest's own lwsync / sync / eieio are translated separately. On x86 both are
// `lock cmpxchg`. REX_GUEST_CAS_LEGACY: the old builtin.
//=============================================================================

#if defined(REX_GUEST_CAS_LEGACY)
#define REX_GUEST_CAS(p, e, d) __sync_bool_compare_and_swap((p), (e), (d))
#else
template <typename T, typename E, typename D>
[[gnu::always_inline]] static inline bool RexGuestCas(T* p, E e, D d) noexcept {
  T expected = static_cast<T>(e);
  return __atomic_compare_exchange_n(p, &expected, static_cast<T>(d), false, __ATOMIC_SEQ_CST,
                                     __ATOMIC_SEQ_CST);
}
#define REX_GUEST_CAS(p, e, d) RexGuestCas((p), (e), (d))
#endif

//=============================================================================
// Setjmp/Longjmp
//=============================================================================

// The host jmp_buf of a guest one, by the guest buffer's address. oblivion (2026-11-10): one table for the process
// under a lock, where upstream has a thread_local table. A guest buffer is one thread's at a time (its stack or its
// own context block), an unordered_map never moves its elements, and the Switch installer's clang build cannot reach
// thread-local storage (nx/tools/build_kit.sh), which the generated code would otherwise use at every setjmp.
inline jmp_buf* ppc_jmp_buf_for(u32 guest_buf_addr, bool create) {
  static std::mutex lock;
  static std::unordered_map<u32, jmp_buf> map;
  std::lock_guard<std::mutex> guard(lock);
  if (create) {
    return &map[guest_buf_addr];
  }
  auto it = map.find(guest_buf_addr);
  return it != map.end() ? &it->second : nullptr;
}

#define ppc_setjmp(guest_buf_addr) (setjmp(*::ppc_jmp_buf_for((guest_buf_addr), true)))

[[noreturn]] inline void ppc_longjmp(u32 guest_buf_addr, int val) {
  if (jmp_buf* buf = ppc_jmp_buf_for(guest_buf_addr, false)) {
    longjmp(*buf, val);
  }
  std::abort();
}

//=============================================================================
// Trap Handling
//=============================================================================

inline void ppc_trap(PPCContext& ctx, u8* base, u16 trap_type) {
  switch (trap_type) {
    case 20:
    case 26: {
      auto str = REX_LOAD_STRING(ctx.r3.u32, ctx.r4.u16);
      REXCPU_DEBUG("(service trap) {}", str);
      break;
    }
    case 0:
    case 22:
      REXCPU_WARN("tw/td trap hit (type {})", trap_type);
      break;
    case 25:
      break;
    default:
      REXCPU_WARN("Unknown trap type {}", trap_type);
      break;
  }
}

//=============================================================================
// Interrupt Locks
//=============================================================================

inline std::atomic<i32>& ppc_global_lock_count_() {
  static std::atomic<i32> count{0};
  return count;
}

#define REX_CHECK_GLOBAL_LOCK()                                        \
  ([&]() -> u64 {                                                      \
    auto lock_ = rex::thread::global_critical_region::AcquireDirect(); \
    return ppc_global_lock_count_().load() ? 0 : 0x8000;               \
  }())

#define REX_ENTER_GLOBAL_LOCK()                          \
  do {                                                   \
    rex::thread::global_critical_region::mutex().lock(); \
    ppc_global_lock_count_().fetch_add(1);               \
  } while (0)

#define REX_LEAVE_GLOBAL_LOCK()                                                           \
  do {                                                                                    \
    auto old_count_ = ppc_global_lock_count_().fetch_sub(1);                              \
    assert(old_count_ >= 1 && "LeaveGlobalLock called without matching EnterGlobalLock"); \
    rex::thread::global_critical_region::mutex().unlock();                                \
  } while (0)
